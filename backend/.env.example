APP_ENV=development
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Shared secret with the Next.js frontend — must match its VIVID_INTERNAL_SECRET
INTERNAL_API_SECRET=change-me-to-a-64-char-random-secret

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vividgen
DATABASE_SCHEMA=core

FAL_KEY=
FAL_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/fal
# Set to "fake" for local development/testing — runs the entire pipeline
# (credit reservation, provider submit, webhook, finalize job, thumbnailing,
# credit charge) with zero fal.ai spend. NEVER set this in production —
# providers/registry.py refuses it when APP_ENV=production.
GENERATION_PROVIDER=fake

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
CDN_BASE_URL=
# Optional — only needed once CloudFront is provisioned in front of the S3
# bucket. Without these, presign_download falls back to plain S3 presigned
# URLs, which is the correct default for local dev/early staging.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

REDIS_URL=redis://redis:6379/0

CREDIT_USD_VALUE=0.01
GENERATION_MARKUP_MULTIPLIER=2.5
MIN_GENERATION_CREDITS=1
FREE_TIER_GRANT_CREDITS=150

MAX_VIDEO_DURATION_SECONDS=60
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_IP_PER_MINUTE=120
MAX_CONCURRENT_GENERATIONS_PER_USER=3
# Global kill switch — set to false to immediately stop all new generation
# submission (e.g. during a fal.ai incident) without taking the API down.
GENERATIONS_ENABLED=true

MAX_SHOTS_PER_PROJECT=40
MAX_CHARACTERS_PER_PROJECT=12

MODERATION_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
# Required in production to access GET /metrics (sent as X-Metrics-Token).
# Docs/redoc/openapi.json are simply disabled outright when APP_ENV=production.
METRICS_TOKEN=

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Cost-estimation assumptions for self-hosted Modal Wan. These are estimates,
# not invoice-confirmed per-call usage. Reconcile against `modal billing report`.
MODAL_L40S_GPU_USD_PER_SECOND=0.000542
MODAL_CPU_USD_PER_CORE_SECOND=0.0000131
MODAL_MEMORY_USD_PER_GIB_SECOND=0.00000222
MODAL_ESTIMATED_CPU_CORES=1.0
MODAL_ESTIMATED_MEMORY_GIB=4.0
MODAL_RUNTIME_SECONDS_PER_OUTPUT_SECOND=85.4
MODAL_COST_SAFETY_FACTOR=1.25
MODAL_COST_RATE_VERSION=modal-public-rates-2026-10
AVATAR_RESERVATION_SECONDS=180
UNKNOWN_MEDIA_RESERVATION_SECONDS=300

# Wan TI2V-5B sampling profile. 20 steps is the speed-test default; benchmark quality before production claims.
WAN_SAMPLE_STEPS=20
WAN_MIN_CONTAINERS=1
WAN_SCALEDOWN_WINDOW_SECONDS=600

# Audio production (optional). Keep provider credentials server-side only.
TTS_PROVIDER=fal_chatterbox
CHATTERBOX_TTS_BASE_URL=
CHATTERBOX_TTS_API_KEY=
CHATTERBOX_TTS_MODE=openai_compatible
CHATTERBOX_TTS_TIMEOUT_SECONDS=180
AUDIO_GENERATION_PROVIDER=fal
FAL_AUDIO_MUSIC_MODEL=fal-ai/stable-audio-25/text-to-audio
FAL_AUDIO_AMBIENCE_MODEL=fal-ai/stable-audio-25/text-to-audio
AUDIO_GENERATION_TIMEOUT_SECONDS=240
AUDIO_TTS_MAX_CONCURRENCY=4
# Published hosted-provider estimates; override after measuring self-hosted costs.
AUDIO_CHATTERBOX_USD_PER_1000_CHARS=0.025
AUDIO_TTS_USD_PER_1000_CHARS=0.05
AUDIO_BED_USD_PER_GENERATION=0.20
AUDIO_RETAIL_MARKUP_MULTIPLIER=3.0

# Phase 8: media extraction and Polar credit-pack reconciliation
URL_REFERENCE_MAX_IMAGES=3
URL_REFERENCE_MAX_IMAGE_BYTES=8388608
POLAR_SMALL_CREDIT_PRODUCT_ID=
POLAR_MEDIUM_CREDIT_PRODUCT_ID=
POLAR_LARGE_CREDIT_PRODUCT_ID=
POLAR_SMALL_CREDIT_AMOUNT=10
POLAR_MEDIUM_CREDIT_AMOUNT=25
POLAR_LARGE_CREDIT_AMOUNT=50
FREE_PLAN_MONTHLY_VIDEO_SECONDS=120
FREE_PLAN_MAX_CONCURRENT_GENERATIONS=1
FREE_PLAN_MAX_PROJECT_DURATION_SECONDS=120
POLAR_SMALL_CREDIT_PRICE_USD=0
POLAR_MEDIUM_CREDIT_PRICE_USD=0
POLAR_LARGE_CREDIT_PRICE_USD=0

PEXELS_API_KEY=
STOCK_PROVIDER_TIMEOUT_SECONDS=15
STOCK_ASSET_MAX_BYTES=209715200
