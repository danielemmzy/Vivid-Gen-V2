APP_ENV=development
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Shared secret with the Next.js frontend — must match its VIVID_INTERNAL_SECRET
INTERNAL_API_SECRET=change-me-to-a-64-char-random-secret

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vividgen
DATABASE_SCHEMA=core

FAL_KEY=
FAL_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/fal
# Set to "fake" for local development/testing — runs the entire pipeline
# (credit reservation, provider submit, webhook, finalize job, thumbnailing,
# credit charge) with zero fal.ai spend. NEVER set this in production —
# providers/registry.py refuses it when APP_ENV=production.
GENERATION_PROVIDER=fake

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
CDN_BASE_URL=
# Optional — only needed once CloudFront is provisioned in front of the S3
# bucket. Without these, presign_download falls back to plain S3 presigned
# URLs, which is the correct default for local dev/early staging.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

REDIS_URL=redis://redis:6379/0

CREDIT_USD_VALUE=0.01
GENERATION_MARKUP_MULTIPLIER=2.5
MIN_GENERATION_CREDITS=1
FREE_TIER_GRANT_CREDITS=150

MAX_VIDEO_DURATION_SECONDS=60
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
RATE_LIMIT_PER_IP_PER_MINUTE=120
MAX_CONCURRENT_GENERATIONS_PER_USER=3
# Global kill switch — set to false to immediately stop all new generation
# submission (e.g. during a fal.ai incident) without taking the API down.
GENERATIONS_ENABLED=true

MAX_SHOTS_PER_PROJECT=40
MAX_CHARACTERS_PER_PROJECT=12

MODERATION_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
# Required in production to access GET /metrics (sent as X-Metrics-Token).
# Docs/redoc/openapi.json are simply disabled outright when APP_ENV=production.
METRICS_TOKEN=

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
