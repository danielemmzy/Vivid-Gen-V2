# Copy this file to .env and fill in the blanks — see the beginner setup
# guide for exactly where each value comes from.

# Same Postgres database the backend uses, but reached via "localhost"
# (Next.js runs directly on your machine, not inside Docker) instead of
# the "postgres" hostname the backend's containers use internally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vividgen

NODE_ENV=development

# The FastAPI backend, running via `docker compose up` in the backend/ folder.
BACKEND_API_URL=http://localhost:8000

# Must be the EXACT same value as INTERNAL_API_SECRET in backend/.env —
# this is the shared password the two apps use to trust each other.
BACKEND_INTERNAL_SECRET=change-me-to-a-64-char-random-secret

# Polar (billing / buying credits) — sandbox/test values are fine to get
# the app running; you only need real ones before taking real payments.
POLAR_ACCESS_TOKEN=placeholder
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=placeholder
BETTER_AUTH_SECRET=
NEXT_PUBLIC_SMALL_CREDIT_ID=placeholder
NEXT_PUBLIC_MEDIUM_CREDIT_ID=placeholder
NEXT_PUBLIC_LARGE_CREDIT_ID=placeholder
